Notebook[{
Cell[TextData[{
 StyleBox["Energy spectra ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   FractionBox["d\[Sigma]", "dEe"], TraditionalForm]],
  FontSize->24,ExpressionUUID->"d0f62e42-c184-4292-bbd7-a21cf8996f28"],
 StyleBox["(Ee, E\[Nu]) are given in units ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "42"}]], " ", 
     SuperscriptBox["cm", "2"], 
     SuperscriptBox["GeV", 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]],
  FontSize->24,ExpressionUUID->"e91233ad-76a1-433c-8c5a-3801884216e8"],
 StyleBox[" as functions of the antineutrino energy E\[Nu] and the energy Ee.\
\nEe stands either for the positron or electromagnetic (sum of positron and \
photon) energies. \n2-dimensional distribution ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "2"], "\[Sigma]"}], 
    RowBox[{"dEe", " ", "df"}]], TraditionalForm]],
  FontSize->24,ExpressionUUID->"bb7d1c15-1feb-4540-9394-421ac1a648cc"],
 StyleBox["(Ee, E\[Nu], f) is given in units ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "42"}]], " ", 
     SuperscriptBox["cm", "2"], 
     SuperscriptBox["GeV", 
      RowBox[{"-", "2"}]]}]}], TraditionalForm]],
  FontSize->24,ExpressionUUID->"469288d3-9eaf-4c76-adba-723fab2a94c5"],
 StyleBox[" as a function of the antineutrino energy E\[Nu], the positron \
energy Ee, and the variable f for the positron scattering angle \[Theta]:\n",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "2"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Beta]", "2"], 
      SuperscriptBox["Ee", "2"]}], "+", 
     SuperscriptBox["E\[Nu]", "2"], "-", 
     RowBox[{
     "2", "\[Beta]", " ", "Ee", " ", "E\[Nu]", " ", "cos\[Theta]"}]}]}], 
   TraditionalForm]],
  FontSize->24,ExpressionUUID->"27146512-ae79-4076-bbc3-d4d8dd36effb"],
 "\n",
 StyleBox["3-dimensional distribution ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "3"], "\[Sigma]"}], 
    RowBox[{"dEe", " ", "df", " ", "dE\[Gamma]"}]], TraditionalForm]],
  FontSize->24,ExpressionUUID->"95b1b810-b5b6-4c76-9897-b8bdb8257587"],
 StyleBox["(Ee, E\[Nu], E\[Gamma], f) is given in units ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "42"}]], " ", 
     SuperscriptBox["cm", "2"], 
     SuperscriptBox["GeV", 
      RowBox[{"-", "3"}]]}]}], TraditionalForm]],
  FontSize->24,ExpressionUUID->"e9aaaf75-f5a3-44be-ad9c-c9f937fd7706"],
 ".",
 StyleBox["\nThe script is based on arXiv:2512.07956, arXiv:2604.07113, \
arXiv:2608.X and and provides results with sub-permille accuracy for \
antineutrino energies below 10 MeV.",
  FontSize->24]
}], "Text",
