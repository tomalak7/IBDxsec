Cell[TextData[StyleBox["QED form factor f2",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.7738391644715033`*^9, 3.773839231597212*^9}, {
  3.7911396355426083`*^9, 3.791139637610676*^9}, {3.95698950846211*^9, 
