Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalSigma]", "[", 
    RowBox[{"m\[Pi]_", ",", "\[CapitalDelta]0_", ",", "Q2_"}], "]"}], ":=", 
   RowBox[{"Re", "[", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Beta]\[CapitalDelta]", "=", 
         FractionBox[
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[CapitalDelta]0", "2"], "-", 
            SuperscriptBox["m\[Pi]", "2"]}]], "\[CapitalDelta]0"]}], ",", 
        RowBox[{"\[Beta]", "=", 
         SqrtBox[
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"4", 
             SuperscriptBox["m\[Pi]", "2"]}], "Q2"]}]]}], ",", 
        RowBox[{"\[Gamma]", "=", 
         FractionBox[
          SqrtBox["Q2"], 
          RowBox[{"2", "\[CapitalDelta]0"}]]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Eta]", " ", 
           RowBox[{"PolyLog", "[", 
            RowBox[{"2", ",", 
             FractionBox[
              RowBox[{"1", "-", 
               RowBox[{"\[Eta]", " ", "\[Gamma]"}]}], 
              RowBox[{"1", "-", 
               RowBox[{"\[Xi]", " ", "\[Beta]", " ", "\[Gamma]"}]}]]}], 
            "]"}]}], "+", 
          RowBox[{"\[Eta]", " ", 
           RowBox[{"PolyLog", "[", 
            RowBox[{"2", ",", 
             FractionBox[
              RowBox[{"\[Eta]", "+", "\[Gamma]"}], 
              RowBox[{
               RowBox[{"\[Xi]", " ", "\[Beta]\[CapitalDelta]"}], "+", 
               "\[Gamma]"}]]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Xi]", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "-", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"\[Eta]", " ", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            FractionBox[
             RowBox[{"\[Eta]", "+", "\[Gamma]"}], "\[Gamma]"]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "-", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"\[Eta]", " ", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            FractionBox[
             RowBox[{"1", "-", 
              RowBox[{"\[Eta]", " ", "\[Gamma]"}]}], "1"]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}]}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]gV\[CapitalDelta]LO", "[", 
