Cell[TextData[StyleBox["QED pion-induced contributions",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.7738391644715033`*^9, 3.773839248336331*^9}, {
   3.7911396173739843`*^9, 3.791139649418229*^9}, {3.95698957804177*^9, 
   3.956989590321772*^9}, 3.9740144500140657`*^9, {3.9839212484103184`*^9, 
   3.983921254600504*^9}},ExpressionUUID->"11a118d0-a186-4511-87e6-\
d7f97c2d16f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pions", "[", 
    RowBox[{
    "m\[Pi]_", ",", "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",",
      "E\[Nu]_", ",", "Ee_", ",", "hc_", ",", "GF_", ",", "Vud_", ",", 
     "\[Alpha]_", ",", "Z\[Pi]_", ",", "c4_"}], "]"}], ":=", 
   RowBox[{"Z\[Pi]", 
    FractionBox["\[Alpha]", "\[Pi]"], 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Q2", "=", 
         RowBox[{
          SuperscriptBox["mp", "2"], "-", 
          SuperscriptBox["mn", "2"], "+", 
          RowBox[{"2", "mp", " ", 
           RowBox[{"(", 
            RowBox[{"E\[Nu]", "-", "Ee"}], ")"}]}]}]}], ",", 
        RowBox[{"E0", "=", 
         FractionBox[
          RowBox[{
           SuperscriptBox["mn", "2"], "+", 
           SuperscriptBox["me", "2"], "-", 
           SuperscriptBox["mp", "2"]}], 
          RowBox[{"2", "mn"}]]}], ",", 
        RowBox[{"\[Beta]", "=", 
         SqrtBox[
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"4", " ", 
             SuperscriptBox["m\[Pi]", "2"]}], "Q2"]}]]}], ",", 
        RowBox[{"\[Delta]gV", "=", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", 
             SuperscriptBox["gA", "2"]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               FractionBox[
                RowBox[{"1", "+", 
                 RowBox[{"3", 
                  SuperscriptBox["gA", "2"]}]}], "2"], "+", 
               RowBox[{
                FractionBox[
                 RowBox[{"1", "-", 
                  SuperscriptBox["\[Beta]", "2"]}], 
                 RowBox[{"2", 
                  SuperscriptBox["\[Beta]", "2"]}]], 
                SuperscriptBox["gA", "2"]}]}], ")"}], "\[Beta]", " ", 
             RowBox[{"Log", "[", 
              FractionBox[
               RowBox[{"\[Beta]", "-", "1"}], 
               RowBox[{"\[Beta]", "+", "1"}]], "]"}]}], "-", 
            RowBox[{"\[Pi]", " ", 
             SuperscriptBox["gA", "2"], 
             RowBox[{"(", 
              RowBox[{
               FractionBox["Q2", 
                RowBox[{"4", "mn", " ", "m\[Pi]"}]], "+", 
               RowBox[{
                FractionBox["m\[Pi]", 
                 RowBox[{"mn", " "}]], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  FractionBox["1", 
                   RowBox[{"4", " ", 
                    SuperscriptBox["\[Beta]", "2"]}]], "-", 
                  FractionBox[
                   RowBox[{
                    SuperscriptBox["\[Beta]", "2"], 
                    RowBox[{"ArcCsc", "[", "\[Beta]", "]"}]}], 
                   SqrtBox[
