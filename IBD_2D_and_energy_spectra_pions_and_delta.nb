         "\[Gamma]"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"2", 
             SuperscriptBox["\[Beta]", "2"], " ", 
             SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]}], "-", 
            SuperscriptBox["\[Gamma]", "2"]}], 
           RowBox[{
            SuperscriptBox["\[Beta]\[CapitalDelta]", "2"], "-", 
            SuperscriptBox["\[Gamma]", "2"]}]], "+", 
          FractionBox[
           SuperscriptBox["\[Gamma]", "2"], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Beta]\[CapitalDelta]", "2"], "-", 
              SuperscriptBox["\[Gamma]", "2"]}], ")"}], "2"]]}], ")"}], 
        "log"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]}], "-", 
          RowBox[{
           FractionBox["1", "2"], 
           FractionBox[
            RowBox[{
             SuperscriptBox["\[Beta]\[CapitalDelta]", "2"], " ", 
             SuperscriptBox["\[Gamma]", "2"]}], 
            RowBox[{
             SuperscriptBox["\[Beta]\[CapitalDelta]", "2"], "-", 
             SuperscriptBox["\[Gamma]", "2"]}]]}], "+", 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Gamma]", "2"], 
            SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[Beta]\[CapitalDelta]", "2"], "-", 
              SuperscriptBox["\[Gamma]", "2"]}], ")"}], "2"]], "+", 
          RowBox[{
           FractionBox["3", "2"], 
           FractionBox[
            SuperscriptBox["\[Gamma]", "2"], 
            RowBox[{
             SuperscriptBox["\[Beta]\[CapitalDelta]", "2"], "-", 
             SuperscriptBox["\[Gamma]", "2"]}]]}]}], ")"}], " ", 
        "log\[CapitalDelta]"}], "+", "5", "-", 
