     RowBox[{"rA2", "->", "0.48"}], ",", 
     RowBox[{"\[Delta]rA2", "->", "0.14"}], ",", 
     RowBox[{"Vud", "->", "0.97348"}], ",", 
     RowBox[{"\[Delta]Vud", "->", "0.00031"}], ",", 
     RowBox[{"GF", "->", 
      RowBox[{"1.1663788", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "5"}]]}]}], " ", ",", 
