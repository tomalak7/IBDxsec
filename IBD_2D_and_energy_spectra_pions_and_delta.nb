Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"resultLOphoton", "[", 
    RowBox[{
    "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",", "rV2_", ",", 
     "rA2_", ",", "\[Mu]V_", ",", "E\[Nu]_", ",", "l0_", ",", "\[Epsilon]_", ",",
      "hc_", ",", "GF_", ",", "Vud_", ",", "\[Alpha]_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"En", "=", 
        RowBox[{"mp", "+", "E\[Nu]", "-", "l0"}]}], ",", 
       RowBox[{"E0", "=", 
        FractionBox[
         RowBox[{
          SuperscriptBox["mn", "2"], "+", 
          SuperscriptBox["me", "2"], "-", 
          SuperscriptBox["mp", "2"]}], 
         RowBox[{"2", "mn"}]]}], ",", 
       RowBox[{"Q2", "=", 
        RowBox[{
         SuperscriptBox["mp", "2"], "-", 
         SuperscriptBox["mn", "2"], "-", 
         RowBox[{"2", "mp", " ", 
          RowBox[{"(", 
           RowBox[{"mp", "-", "En"}], ")"}]}]}]}], ",", 
       RowBox[{"\[Beta]0", "=", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["me", "2"], 
           SuperscriptBox["l0", "2"]]}]]}]}], "}"}], ",", 
     RowBox[{
      SuperscriptBox["10", "16"], 
      SuperscriptBox["hc", "2"], 
      SuperscriptBox["GF", "2"], 
      SuperscriptBox["Vud", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "+", 
              SuperscriptBox["gA", "2"]}], ")"}], 
            FractionBox["l0", "E\[Nu]"]}], "-", " ", 
           RowBox[{
            FractionBox[
             RowBox[{
              SuperscriptBox["me", "2"], "+", "Q2"}], 
             RowBox[{"4", 
              SuperscriptBox["E\[Nu]", "2"]}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "-", 
              SuperscriptBox["gA", "2"]}], ")"}]}]}], ")"}], 
         FractionBox["mp", "\[Pi]"], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            FractionBox["\[Alpha]", "\[Pi]"], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Delta]v", "[", "\[Beta]0", "]"}], "+", 
              RowBox[{"\[Delta]sd\[Epsilon]", "[", 
               RowBox[{"l0", ",", "\[Epsilon]", ",", "me"}], "]"}], "+", 
              RowBox[{"\[Delta]2p", "[", 
               RowBox[{"E\[Nu]", ",", "l0", ",", "En", ",", "mn", ",", "me"}],
                "]"}]}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["gV", "2"], "+", 
             SuperscriptBox["gA", "2"]}], ")"}], 
           FractionBox["l0", "E\[Nu]"]}], ")"}], 
         FractionBox["mp", "\[Pi]"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["gV", "2"], "+", 
             SuperscriptBox["gA", "2"]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox["E0", "E\[Nu]"]}], ")"}]}], ")"}], 
         FractionBox["mp", "\[Pi]"]}], "+", 
        RowBox[{
         FractionBox["\[Alpha]", "\[Pi]"], 
         FractionBox["mp", "\[Pi]"], 
         FractionBox["me", "E\[Nu]"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["gV", "2"], "+", 
           RowBox[{"3", 
            SuperscriptBox["gA", "2"]}]}], ")"}], 
         FractionBox[
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["\[Beta]0", "2"]}]], 
          RowBox[{"4", "\[Beta]0"}]], 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"1", "+", "\[Beta]0"}], 
           RowBox[{"1", "-", "\[Beta]0"}]], "]"}]}], "+", 
        RowBox[{"recoil", "[", 
         RowBox[{
         "mp", ",", "mn", ",", "me", ",", "gV", ",", "gA", ",", "E0", ",", 
          "E\[Nu]", ",", "Q2"}], "]"}], "+", 
        RowBox[{"WM", "[", 
         RowBox[{
         "mp", ",", "mn", ",", "me", ",", "gV", ",", "gA", ",", "\[Mu]V", ",",
           "E0", ",", "E\[Nu]", ",", "Q2"}], "]"}], "+", 
        RowBox[{
         SuperscriptBox["hc", 
          RowBox[{"-", "2"}]], 
         RowBox[{"FF", "[", 
          RowBox[{
          "mp", ",", "me", ",", "gV", ",", "gA", ",", "rV2", ",", "rA2", ",", 
           "E0", ",", "E\[Nu]", ",", "Q2"}], "]"}]}]}], ")"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.956720877700779*^9, 3.956720881071883*^9}, {
   3.95675223245226*^9, 3.956752312785961*^9}, {3.956752397773983*^9, 
   3.956752399898246*^9}, {3.956752861309579*^9, 3.956752864447027*^9}, 
   3.956752916332712*^9, {3.956885359718032*^9, 3.956885372567791*^9}, {
   3.9568854520205793`*^9, 3.956885467235154*^9}, {3.956885571496131*^9, 
   3.9568856140401983`*^9}, {3.9568859144456673`*^9, 3.956885919420212*^9}, {
   3.9568864983793573`*^9, 3.956886499767721*^9}, {3.95688870729226*^9, 
   3.956888733889311*^9}, {3.956889119803487*^9, 3.956889158327456*^9}, 
   3.956893462287868*^9, {3.956896971742466*^9, 3.956897071763215*^9}, 
   3.956899993089593*^9, {3.956916832946179*^9, 3.956916833342651*^9}, {
   3.95693468925541*^9, 3.956934707617111*^9}, 3.9571830243932743`*^9, {
   3.984121394322517*^9, 3.984121427722192*^9}, 3.9841215410872974`*^9, 
   3.984121599913257*^9, {3.984122068756694*^9, 3.9841220736215773`*^9}, {
   3.9841221734839587`*^9, 3.984122180117524*^9}, 3.9841222324284067`*^9, {
   3.984260458535041*^9, 3.9842604988177423`*^9}, {3.984286712163108*^9, 
   3.984286719279703*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"5e27eecf-1582-49d8-80d6-fa53706d08ca"],

Cell[TextData[StyleBox["2-dimensional distribution in positron energy and \
angle",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.7738391644715033`*^9, 3.773839248336331*^9}, {
   3.7911396173739843`*^9, 3.791139649418229*^9}, {3.95698957804177*^9, 
