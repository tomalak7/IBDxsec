Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]s", "[", 
    RowBox[{"\[Beta]_", ",", "me_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "\[Beta]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", 
         FractionBox[
          RowBox[{"1", "-", "\[Beta]"}], 
          RowBox[{"1", "+", "\[Beta]"}]]}], "]"}], "-", 
       FractionBox[
        SuperscriptBox["\[Pi]", "2"], "6"]}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "\[Beta]"}]], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ")"}], 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"4", 
        SuperscriptBox["\[Epsilon]", "2"]}], 
       SuperscriptBox["me", "2"]], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Beta]"}]], 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", "\[Beta]"}], 
       RowBox[{"1", "-", "\[Beta]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["\[Beta]", "2"]}]], 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Beta]"}], ")"}]}], 
         RowBox[{"4", 
          SuperscriptBox["\[Beta]", "2"]}]], "]"}]}], ")"}]}], "+", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]sd\[Epsilon]", "[", 
    RowBox[{"Ee_", ",", "\[Epsilon]_", ",", "me_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Beta]", "=", 
       SqrtBox[
        RowBox[{"1", "-", 
         FractionBox[
          SuperscriptBox["me", "2"], 
          SuperscriptBox["Ee", "2"]]}]]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["1", "\[Beta]"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PolyLog", "[", 
          RowBox[{"2", ",", 
           FractionBox[
            RowBox[{"1", "-", "\[Beta]"}], 
            RowBox[{"1", "+", "\[Beta]"}]]}], "]"}], "-", 
         FractionBox[
          SuperscriptBox["\[Pi]", "2"], "6"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", "\[Beta]"}]], 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"1", "+", "\[Beta]"}], 
            RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ")"}], 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"4", 
          SuperscriptBox["\[Epsilon]", "2"]}], 
         SuperscriptBox["me", "2"]], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "\[Beta]"}]], 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"1", "+", "\[Beta]"}], 
         RowBox[{"1", "-", "\[Beta]"}]], "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["\[Beta]", "2"]}]], 
            RowBox[{"(", 
             RowBox[{"1", "+", "\[Beta]"}], ")"}]}], 
           RowBox[{"4", 
            SuperscriptBox["\[Beta]", "2"]}]], "]"}]}], ")"}]}], "+", "1"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]v", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["3", "4"]}], "+", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Beta]"}]], 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"2", "\[Beta]"}]]}], "]"}], "-", 
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", 
         FractionBox[
          RowBox[{"\[Beta]", "-", "1"}], 
          RowBox[{"2", "\[Beta]"}]]}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"2", "\[Beta]"}], 
            RowBox[{"1", "-", "\[Beta]"}]], "]"}]}], ")"}], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"1", "+", "\[Beta]"}], 
           RowBox[{"1", "-", "\[Beta]"}]], "]"}], "2"]}], "-", 
       FractionBox[
        SuperscriptBox["\[Pi]", "2"], "2"]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]2EM", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "\[Beta]"}]], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ")"}]}], 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"1", "+", "\[Beta]"}], 
      RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]2p", "[", 
    RowBox[{"E\[Nu]_", ",", "Ee_", ",", "En_", ",", "mn_", ",", "me_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Beta]", "=", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["me", "2"], 
           SuperscriptBox["Ee", "2"]]}]]}], ",", 
       RowBox[{"\[Beta]x", "=", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["mn", "2"], 
           SuperscriptBox["En", "2"]]}]]}], ",", 
       RowBox[{"\[Rho]", "=", 
        FractionBox["me", "Ee"]}], ",", 
       RowBox[{"\[Rho]x", "=", 
        FractionBox["mn", "En"]}], ",", 
       RowBox[{"cos\[Delta]", "=", 
        FractionBox[
         RowBox[{
          SuperscriptBox["E\[Nu]", "2"], "-", 
          RowBox[{
           SuperscriptBox["\[Beta]", "2"], 
           SuperscriptBox["Ee", "2"]}], "-", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["En", "2"], "-", 
            SuperscriptBox["mn", "2"]}], ")"}]}], 
         RowBox[{"2", "\[Beta]", " ", "Ee", " ", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["En", "2"], "-", 
            SuperscriptBox["mn", "2"]}]]}]]}]}], "}"}], ",", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["1", 
           RowBox[{"2", " ", "\[Beta]x"}]]}], ")"}], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]x"}], 
          RowBox[{"1", "-", "\[Beta]x"}]], "]"}]}], "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "\[Beta]"}]], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}]}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"1", "-", 
          RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}], 
         RowBox[{"2", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}], 
              ")"}], "2"], "-", 
            RowBox[{
             SuperscriptBox["\[Rho]", "2"], 
             SuperscriptBox["\[Rho]x", "2"]}]}]]}]], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "-", 
           RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}], "+", 
           SqrtBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}], 
               ")"}], "2"], "-", 
             RowBox[{
              SuperscriptBox["\[Rho]", "2"], 
              SuperscriptBox["\[Rho]x", "2"]}]}]]}], 
          RowBox[{"1", "-", 
           RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}], "-", 
           SqrtBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}], 
               ")"}], "2"], "-", 
             RowBox[{
              SuperscriptBox["\[Rho]", "2"], 
              SuperscriptBox["\[Rho]x", "2"]}]}]]}]], "]"}]}], "+", 
       RowBox[{
        FractionBox["1", "\[Beta]"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox[
            RowBox[{"Log", "[", 
             FractionBox[
              RowBox[{"1", "+", "\[Beta]"}], 
              RowBox[{"1", "-", "\[Beta]"}]], "]"}], "2"]}], "+", 
          RowBox[{
           RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{"1", "+", "\[Beta]"}], 
             RowBox[{"1", "-", "\[Beta]"}]], "]"}], " ", 
           RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{"2", " ", "\[Beta]", " ", 
              RowBox[{"(", 
               RowBox[{"\[Beta]x", "+", "1"}], ")"}]}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Beta]", "+", "1"}], ")"}], " ", "\[Beta]x", " ", 
              RowBox[{"(", 
               RowBox[{"cos\[Delta]", "+", "1"}], ")"}]}]], "]"}]}], "-", " ", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "cos\[Delta]"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "\[Beta]"}], ")"}], " ", 
              "\[Beta]x"}], 
             RowBox[{"\[Beta]", "-", 
              RowBox[{"cos\[Delta]", " ", "\[Beta]x"}], "+", 
              SqrtBox[
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}],
                   ")"}], "2"], "-", 
                RowBox[{
                 SuperscriptBox["\[Rho]", "2"], 
                 SuperscriptBox["\[Rho]x", "2"]}]}]]}]]}], "]"}], "+", " ", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "cos\[Delta]"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Beta]"}], ")"}], " ", "\[Beta]x"}], 
              RowBox[{"\[Beta]", "-", 
               RowBox[{"cos\[Delta]", " ", "\[Beta]x"}], "+", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    RowBox[{
                    "\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}], ")"}],
                   "2"], "-", 
                 RowBox[{
                  SuperscriptBox["\[Rho]", "2"], 
                  SuperscriptBox["\[Rho]x", "2"]}]}]]}]]}]}], "]"}], "-", " ", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            RowBox[{"-", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "cos\[Delta]"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "\[Beta]"}], ")"}], " ", 
               "\[Beta]x"}], 
              RowBox[{
               RowBox[{"-", "\[Beta]"}], "+", 
               RowBox[{"cos\[Delta]", " ", "\[Beta]x"}], "+", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    RowBox[{
                    "\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}], ")"}],
                   "2"], "-", 
                 RowBox[{
                  SuperscriptBox["\[Rho]", "2"], 
                  SuperscriptBox["\[Rho]x", "2"]}]}]]}]]}]}], "]"}], "+", " ", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "cos\[Delta]"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Beta]"}], ")"}], " ", "\[Beta]x"}], 
             RowBox[{
              RowBox[{"-", "\[Beta]"}], "+", 
              RowBox[{"cos\[Delta]", " ", "\[Beta]x"}], "+", 
              SqrtBox[
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"\[Beta]", " ", "\[Beta]x", " ", "cos\[Delta]"}]}],
                   ")"}], "2"], "-", 
                RowBox[{
                 SuperscriptBox["\[Rho]", "2"], 
                 SuperscriptBox["\[Rho]x", "2"]}]}]]}]]}], "]"}]}], ")"}]}]}],
       "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.956073808514769*^9, 3.956073813441983*^9}, 
