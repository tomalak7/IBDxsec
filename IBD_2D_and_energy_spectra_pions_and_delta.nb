Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"result2D", "[", 
    RowBox[{
    "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",", "rV2_", ",", 
     "rA2_", ",", "\[Mu]V_", ",", "E\[Nu]_", ",", "Ee_", ",", "f_", ",", 
     "hc_", ",", "GF_", ",", "Vud_", ",", "\[Alpha]_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox["10", "16"], 
    SuperscriptBox["hc", "2"], 
    FractionBox["\[Alpha]", "\[Pi]"], 
    SuperscriptBox["GF", "2"], 
    SuperscriptBox["Vud", "2"], 
    FractionBox["mp", 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["E\[Nu]", "2"]}]], 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l0", "=", 
         RowBox[{"mp", "+", "E\[Nu]", "-", "Ee"}]}], ",", 
        RowBox[{"E0", "=", 
         FractionBox[
          RowBox[{
           SuperscriptBox["mn", "2"], "+", 
           SuperscriptBox["me", "2"], "-", 
           SuperscriptBox["mp", "2"]}], 
          RowBox[{"2", "mn"}]]}], ",", 
        RowBox[{"\[CapitalDelta]", "=", 
         RowBox[{
          RowBox[{"mp", " ", "E\[Nu]"}], "-", 
          RowBox[{"mn", " ", "E0"}]}]}], ",", 
        RowBox[{"s", "=", 
         RowBox[{
          SuperscriptBox["mp", "2"], "+", 
          RowBox[{"2", "mp", " ", "E\[Nu]"}]}]}], ",", 
        RowBox[{"\[CapitalSigma]", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"s", "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"me", "-", "mn"}], ")"}], "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"s", "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"me", "+", "mn"}], ")"}], "2"]}], ")"}]}]}], ",", 
        RowBox[{"Q2", "=", 
         RowBox[{
          SuperscriptBox["mp", "2"], "-", 
          SuperscriptBox["mn", "2"], "-", 
          RowBox[{"2", "mp", " ", 
           RowBox[{"(", 
            RowBox[{"Ee", "-", "E\[Nu]"}], ")"}]}]}]}], ",", 
        RowBox[{"\[Beta]", "=", 
         SqrtBox[
          RowBox[{"1", "-", 
           FractionBox[
            SuperscriptBox["me", "2"], 
            SuperscriptBox["Ee", "2"]]}]]}], ",", 
        RowBox[{"cos\[Delta]", "=", 
         FractionBox[
          RowBox[{
           SuperscriptBox["E\[Nu]", "2"], "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["Ee", "2"], "-", 
             SuperscriptBox["me", "2"]}], ")"}], "-", 
           SuperscriptBox["f", "2"]}], 
          RowBox[{"2", "f", " ", 
           SqrtBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["Ee", "2"], "-", 
              SuperscriptBox["me", "2"]}], ")"}]]}]]}], ",", 
        RowBox[{"l2", "=", 
         RowBox[{
          SuperscriptBox["l0", "2"], "-", 
          SuperscriptBox["f", "2"]}]}], ",", 
        RowBox[{"g", "=", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f", " ", "cos\[Delta]"}], "-", 
             RowBox[{"\[Beta]", " ", "l0"}]}], ")"}], "2"], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["\[Beta]", "2"]}], ")"}], 
           SuperscriptBox["f", "2"], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["cos\[Delta]", "2"]}], ")"}]}]}]}]}], "}"}], ",", 
      
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"f", " ", "\[Beta]"}], "g"]}], "E\[Nu]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Beta]", " ", "l0"}], "-", 
           RowBox[{"f", " ", "cos\[Delta]"}], "-", 
           RowBox[{"f", 
            FractionBox[
             RowBox[{"f", "-", 
              RowBox[{"\[Beta]", " ", "l0", " ", "cos\[Delta]"}]}], 
             RowBox[{"2", "\[Beta]", " ", "Ee"}]], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["mn", "2"], "l2"]}], ")"}]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["gV", "2"], "+", 
           SuperscriptBox["gA", "2"]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox["f", "2"], "-", 
           RowBox[{
            FractionBox[
             RowBox[{"f", " ", "\[Beta]"}], 
             RowBox[{"2", " ", "g"}]], "mp", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Beta]", " ", "l0"}], "-", 
              RowBox[{"f", " ", "cos\[Delta]"}]}], ")"}]}], "-", 
           RowBox[{
            FractionBox["f", "4"], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["mn", "2"], "l2"]}], ")"}]}], "+", 
           RowBox[{
            FractionBox[
             SuperscriptBox["f", "2"], "g"], " ", "mp", 
            FractionBox[
             RowBox[{"f", "-", 
              RowBox[{"\[Beta]", " ", "l0", " ", "cos\[Delta]"}]}], 
             RowBox[{"4", "Ee"}]], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               SuperscriptBox["mn", "2"], "l2"]}], ")"}]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["gV", "2"], "-", 
           SuperscriptBox["gA", "2"]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox["E\[Nu]", "2"]}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "+", 
              SuperscriptBox["gA", "2"]}], ")"}]}], "+", 
           RowBox[{
            FractionBox[
             RowBox[{"E\[Nu]", "-", "Ee"}], "4"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "-", 
              SuperscriptBox["gA", "2"]}], ")"}]}]}], ")"}], 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"l0", "+", "f"}], 
           RowBox[{"l0", "-", "f"}]], "]"}]}], "-", 
        RowBox[{
         FractionBox["f", 
          RowBox[{"4", "\[Beta]"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["gV", "2"], "-", 
           SuperscriptBox["gA", "2"]}], ")"}], " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"1", "+", "\[Beta]"}], 
           RowBox[{"1", "-", "\[Beta]"}]], "]"}]}], "-", 
        RowBox[{
         FractionBox["f", 
          RowBox[{"4", " ", 
           SuperscriptBox["g", 
            FractionBox["3", "2"]], 
           SuperscriptBox["Ee", "2"]}]], 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"l0", "-", 
            RowBox[{"\[Beta]", " ", "f", " ", "cos\[Delta]"}], "-", 
            SqrtBox["g"]}], 
           RowBox[{"l0", "-", 
            RowBox[{"\[Beta]", " ", "f", " ", "cos\[Delta]"}], "+", 
            SqrtBox["g"]}]], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"E\[Nu]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", "g", " ", 
               SuperscriptBox["Ee", "2"]}], "+", 
              RowBox[{"\[Beta]", " ", "Ee", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[Beta]", " ", "l0"}], "-", 
                 RowBox[{"f", " ", "cos\[Delta]"}]}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"l2", "-", 
                 SuperscriptBox["mn", "2"]}], ")"}]}], "-", 
              RowBox[{"2", " ", "f", " ", 
               SuperscriptBox["me", "2"], 
               RowBox[{"(", 
                RowBox[{"f", "-", 
                 RowBox[{"\[Beta]", " ", "cos\[Delta]", " ", "l0"}]}], 
                ")"}]}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "+", 
              SuperscriptBox["gA", "2"]}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               FractionBox["mp", 
                RowBox[{"2", "E\[Nu]"}]], "E\[Nu]", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"4", "g", " ", 
                  SuperscriptBox["Ee", "2"]}], " ", "+", 
                 RowBox[{"\[Beta]", " ", "Ee", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Beta]", " ", "l0"}], "-", 
                    RowBox[{"f", " ", "cos\[Delta]"}]}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"l2", "-", 
                    SuperscriptBox["mn", "2"]}], ")"}]}], "-", 
                 RowBox[{"2", " ", "f", " ", 
                  SuperscriptBox["me", "2"], 
                  RowBox[{"(", 
                   RowBox[{"f", "-", 
                    RowBox[{"\[Beta]", " ", "cos\[Delta]", " ", "l0"}]}], 
                   ")"}]}]}], ")"}]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"mn", " ", "E0"}], "-", 
                 RowBox[{"mp", " ", "E\[Nu]"}]}], ")"}], " ", "Ee", " ", 
               "g"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "-", 
              SuperscriptBox["gA", "2"]}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"2", "\[Beta]"}]], 
            RowBox[{"Log", "[", 
             FractionBox[
              RowBox[{"1", "+", "\[Beta]"}], 
              RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ")"}], 
         FractionBox[
          RowBox[{"2", "f"}], 
          RowBox[{"l2", "-", 
           SuperscriptBox["mn", "2"]}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"E\[Nu]", " ", "Ee", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "+", 
              SuperscriptBox["gA", "2"]}], ")"}]}], "+", 
           RowBox[{
            FractionBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"Ee", "-", "E\[Nu]"}], ")"}], "2"], "-", 
              SuperscriptBox["f", "2"], "-", 
              SuperscriptBox["me", "2"]}], "4"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "-", 
              SuperscriptBox["gA", "2"]}], ")"}]}]}], ")"}]}]}], "]"}]}], 
     "]"}]}]}], ";"}]], "Input",
