Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"recoil", "[", 
    RowBox[{
    "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",", "E0_", ",", 
     "E\[Nu]_", ",", "Q2_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["mp", "\[Pi]"], 
    FractionBox["E0", "mn"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["E0", "E\[Nu]"]}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["gV", "2"], "+", 
         SuperscriptBox["gA", "2"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["gV", "2"], "-", 
         SuperscriptBox["gA", "2"]}], ")"}], 
       FractionBox[
        RowBox[{"Q2", "+", 
         SuperscriptBox["me", "2"]}], 
        RowBox[{"4", 
         SuperscriptBox["E\[Nu]", "2"]}]]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"Q2", "+", 
           SuperscriptBox["me", "2"]}], 
          RowBox[{"4", 
           SuperscriptBox["E\[Nu]", "2"]}]], "-", 
         FractionBox["Q2", 
          RowBox[{"2", "E\[Nu]", " ", "E0"}]]}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"gV", "-", "gA"}], ")"}], "2"]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WM", "[", 
    RowBox[{
    "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",", "\[Mu]V_", ",",
      "E0_", ",", "E\[Nu]_", ",", "Q2_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["mp", "\[Pi]"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["E0", "mn"], 
       FractionBox[
        RowBox[{"Q2", "+", 
         SuperscriptBox["me", "2"]}], 
        RowBox[{"2", 
         SuperscriptBox["E\[Nu]", "2"]}]]}], "-", 
      FractionBox["Q2", 
       RowBox[{"mn", " ", "E\[Nu]"}]]}], ")"}], "gA", 
    RowBox[{"(", 
     RowBox[{"\[Mu]V", "-", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FF", "[", 
    RowBox[{
    "mp_", ",", "me_", ",", "gV_", ",", "gA_", ",", "rV2_", ",", "rA2_", ",", 
     "E0_", ",", "E\[Nu]_", ",", "Q2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["mp", "\[Pi]"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox["E0", "E\[Nu]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["gA", "2"], "rA2"}], "+", 
         RowBox[{
          SuperscriptBox["gV", "2"], "rV2"}]}], ")"}]}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"Q2", "+", 
         SuperscriptBox["me", "2"]}], 
        RowBox[{"4", 
         SuperscriptBox["E\[Nu]", "2"]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["gV", "2"], "rV2"}], "-", 
         RowBox[{
          SuperscriptBox["gA", "2"], "rA2"}]}], ")"}]}]}], " ", ")"}], 
    FractionBox["Q2", "3"]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.956885286946884*^9, 3.956885353990049*^9}, {
  3.9568855664268637`*^9, 3.956885567780304*^9}, {3.95688638422139*^9, 
  3.956886384425091*^9}, {3.956931565507167*^9, 3.956931565649024*^9}, {
