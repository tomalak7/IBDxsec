Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"deltas", "[", 
    RowBox[{
    "m\[Pi]_", ",", "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",",
      "E\[Nu]_", ",", "Ee_", ",", "hc_", ",", "GF_", ",", "Vud_", ",", 
     "\[Alpha]_", ",", "Z\[Pi]_", ",", "\[CapitalDelta]0_", ",", "h_", ",", 
     "g1_"}], "]"}], ":=", 
   RowBox[{"Z\[Pi]", 
    FractionBox["\[Alpha]", "\[Pi]"], 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Q2", "=", 
         RowBox[{
          SuperscriptBox["mp", "2"], "-", 
          SuperscriptBox["mn", "2"], "+", 
          RowBox[{"2", "mp", " ", 
           RowBox[{"(", 
            RowBox[{"E\[Nu]", "-", "Ee"}], ")"}]}]}]}], ",", 
        RowBox[{"\[Beta]\[CapitalDelta]", "=", 
         FractionBox[
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[CapitalDelta]0", "2"], "-", 
            SuperscriptBox["m\[Pi]", "2"]}]], "\[CapitalDelta]0"]}], ",", 
        RowBox[{"\[Beta]", "=", 
         SqrtBox[
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"4", " ", 
             SuperscriptBox["m\[Pi]", "2"]}], "Q2"]}]]}], ",", 
        RowBox[{"\[Gamma]", "=", 
         FractionBox[
          SqrtBox["Q2"], 
          RowBox[{"2", "\[CapitalDelta]0"}]]}], ",", 
        RowBox[{"log\[CapitalDelta]", "=", 
         RowBox[{
          FractionBox["1", "\[Beta]\[CapitalDelta]"], 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"1", "-", "\[Beta]\[CapitalDelta]"}], 
            RowBox[{"1", "+", "\[Beta]\[CapitalDelta]"}]], "]"}]}]}], ",", 
        RowBox[{"log", "=", 
         RowBox[{
          FractionBox["1", "\[Beta]"], 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"\[Beta]", "-", "1"}], 
            RowBox[{"\[Beta]", "+", "1"}]], "]"}]}]}], ",", 
        RowBox[{"\[Delta]gV", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Delta]gV\[CapitalDelta]LO", "[", 
             RowBox[{"m\[Pi]", ",", "h", ",", "\[CapitalDelta]0", ",", "Q2"}],
              "]"}], "+", 
            RowBox[{"\[Delta]gV\[CapitalDelta]NLO", "[", 
             RowBox[{"m\[Pi]", ",", "h", ",", "\[CapitalDelta]0", ",", "Q2"}],
              "]"}], "+", 
            RowBox[{
             SuperscriptBox["h", "2"], 
             FractionBox["Q2", 
              RowBox[{"mn", " ", "\[CapitalDelta]0"}]], 
             FractionBox["1", 
              SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]], 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{
                FractionBox[
                 RowBox[{"1", "-", 
                  SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]}], "2"], " ", 
                "log\[CapitalDelta]"}]}], ")"}]}]}], ")"}], " ", "gV"}]}], ",", 
        RowBox[{"\[Delta]gA", "=", 
         RowBox[{
          RowBox[{
           SuperscriptBox["h", "2"], 
           FractionBox["5", "27"], 
           FractionBox["g1", "gA"], 
           FractionBox["Q2", 
            RowBox[{"mn", " ", "\[CapitalDelta]0"}]], 
           FractionBox["1", 
            SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              FractionBox[
               RowBox[{"1", "-", 
                SuperscriptBox["\[Beta]\[CapitalDelta]", "2"]}], "2"], " ", 
              "log\[CapitalDelta]"}]}], ")"}], " ", "gA"}], "-", 
          RowBox[{
           SuperscriptBox["h", "2"], 
           FractionBox["1", "3"], 
           FractionBox["Q2", 
            RowBox[{"mn", " ", "\[CapitalDelta]0"}]], "log\[CapitalDelta]", " ",
            "gA"}]}]}]}], "}"}], ",", 
      RowBox[{
       SuperscriptBox["10", "16"], 
       SuperscriptBox["hc", "2"], 
       SuperscriptBox["GF", "2"], 
       SuperscriptBox["Vud", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
