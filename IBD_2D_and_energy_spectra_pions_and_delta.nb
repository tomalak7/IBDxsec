Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"resultLO", "[", 
    RowBox[{
    "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",", "rV2_", ",", 
     "rA2_", ",", "\[Mu]V_", ",", "E\[Nu]_", ",", "Ee_", ",", "hc_", ",", 
     "GF_", ",", "Vud_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"En", "=", 
        RowBox[{"mp", "+", "E\[Nu]", "-", "Ee"}]}], ",", 
       RowBox[{"E0", "=", 
        FractionBox[
         RowBox[{
          SuperscriptBox["mn", "2"], "+", 
          SuperscriptBox["me", "2"], "-", 
          SuperscriptBox["mp", "2"]}], 
         RowBox[{"2", "mn"}]]}], ",", 
       RowBox[{"\[CapitalDelta]", "=", 
        RowBox[{
         RowBox[{"mp", " ", "E\[Nu]"}], "-", 
         RowBox[{"mn", " ", "E0"}]}]}], ",", 
       RowBox[{"s", "=", 
        RowBox[{
         SuperscriptBox["mp", "2"], "+", 
         RowBox[{"2", "mp", " ", "E\[Nu]"}]}]}], ",", 
       RowBox[{"Q2", "=", 
        RowBox[{
         SuperscriptBox["mp", "2"], "-", 
         SuperscriptBox["mn", "2"], "-", 
         RowBox[{"2", "mp", " ", 
          RowBox[{"(", 
           RowBox[{"mp", "-", "En"}], ")"}]}]}]}], ",", 
       RowBox[{"\[Beta]", "=", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["mn", "2"], 
           SuperscriptBox["En", "2"]]}]]}], ",", 
       RowBox[{"\[Beta]0", "=", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           SuperscriptBox["me", "2"], 
           SuperscriptBox["Ee", "2"]]}]]}], ",", 
       RowBox[{"\[Rho]", "=", 
        FractionBox["mn", "En"]}], ",", 
       RowBox[{"\[Rho]0", "=", 
        FractionBox["me", "Ee"]}]}], "}"}], ",", 
     RowBox[{
      SuperscriptBox["10", "16"], 
      SuperscriptBox["hc", "2"], 
      SuperscriptBox["GF", "2"], 
      SuperscriptBox["Vud", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "+", 
              SuperscriptBox["gA", "2"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox["E0", "E\[Nu]"]}], ")"}]}], "-", " ", 
           RowBox[{
            FractionBox[
             RowBox[{
              SuperscriptBox["me", "2"], "+", "Q2"}], 
             RowBox[{"4", 
              SuperscriptBox["E\[Nu]", "2"]}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["gV", "2"], "-", 
              SuperscriptBox["gA", "2"]}], ")"}]}]}], ")"}], 
         FractionBox["mp", "\[Pi]"]}], "+", 
        RowBox[{"recoil", "[", 
         RowBox[{
         "mp", ",", "mn", ",", "me", ",", "gV", ",", "gA", ",", "E0", ",", 
          "E\[Nu]", ",", "Q2"}], "]"}], "+", 
        RowBox[{"WM", "[", 
         RowBox[{
         "mp", ",", "mn", ",", "me", ",", "gV", ",", "gA", ",", "\[Mu]V", ",",
           "E0", ",", "E\[Nu]", ",", "Q2"}], "]"}], "+", 
        RowBox[{
         SuperscriptBox["hc", 
          RowBox[{"-", "2"}]], 
         RowBox[{"FF", "[", 
          RowBox[{
          "mp", ",", "me", ",", "gV", ",", "gA", ",", "rV2", ",", "rA2", ",", 
           "E0", ",", "E\[Nu]", ",", "Q2"}], "]"}]}]}], ")"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.956720877700779*^9, 3.956720881071883*^9}, {
   3.95675223245226*^9, 3.956752312785961*^9}, {3.956752397773983*^9, 
