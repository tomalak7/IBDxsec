     RowBox[{"f", "->", "0.0035"}], ",", 
     RowBox[{"E\[Gamma]", "\[Rule]", "0.0016965"}], ",", 
     RowBox[{"\[Epsilon]", "->", 
      RowBox[{"3", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "20"}]]}]}], ",", 
     RowBox[{"\[Delta]gV", "->", "0.00013"}], ",", 
