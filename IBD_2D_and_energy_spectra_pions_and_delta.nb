Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["\[Beta]", "2"]}]], 
     RowBox[{"4", "\[Beta]"}]], 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"1", "+", "\[Beta]"}], 
      RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.956990199507152*^9, 3.956990205551568*^9}},
