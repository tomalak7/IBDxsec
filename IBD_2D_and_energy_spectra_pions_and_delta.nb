Cell[TextData[StyleBox["3-dimensional distribution in positron energy, angle, \
and photon energy",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.7738391644715033`*^9, 3.773839248336331*^9}, {
   3.7911396173739843`*^9, 3.791139649418229*^9}, {3.95698957804177*^9, 
   3.956989590321772*^9}, {3.9569896774704437`*^9, 3.956989702431779*^9}, {
   3.956989796528986*^9, 3.9569898128435593`*^9}, {3.956990281466538*^9, 
   3.956990287917157*^9}, {3.956990485101461*^9, 3.956990495987494*^9}, {
   3.9569905313111486`*^9, 3.956990564823824*^9}, 3.956990726708735*^9, 
   3.9573491734271173`*^9, {3.984259529696117*^9, 
   3.9842595402001343`*^9}},ExpressionUUID->"ed64eb34-7284-4e5f-8caa-\
1f49a8f03d03"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"result3D", "[", 
    RowBox[{
    "mp_", ",", "mn_", ",", "me_", ",", "gV_", ",", "gA_", ",", "rV2_", ",", 
     "rA2_", ",", "\[Mu]V_", ",", "E\[Nu]_", ",", "Ee_", ",", "E\[Gamma]_", ",",
      "f_", ",", "hc_", ",", "GF_", ",", "Vud_", ",", "\[Alpha]_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox["10", "16"], 
    SuperscriptBox["hc", "2"], 
    FractionBox["\[Alpha]", "\[Pi]"], 
    SuperscriptBox["GF", "2"], 
    SuperscriptBox["Vud", "2"], 
    FractionBox["mp", 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["E\[Nu]", "2"]}]], 
    FractionBox["1", "E\[Gamma]"], 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l0", "=", 
         RowBox[{"mp", "+", "E\[Nu]", "-", "Ee"}]}], ",", 
        RowBox[{"E0", "=", 
         FractionBox[
          RowBox[{
           SuperscriptBox["mn", "2"], "+", 
           SuperscriptBox["me", "2"], "-", 
           SuperscriptBox["mp", "2"]}], 
          RowBox[{"2", "mn"}]]}], ",", 
        RowBox[{"\[Beta]", "=", 
         SqrtBox[
          RowBox[{"1", "-", 
           FractionBox[
            SuperscriptBox["me", "2"], 
            SuperscriptBox["Ee", "2"]]}]]}], ",", 
        RowBox[{"\[Theta]", "=", 
         FractionBox["me", "Ee"]}], ",", 
        RowBox[{"l2", "=", 
         RowBox[{
          SuperscriptBox["l0", "2"], "-", 
          SuperscriptBox["f", "2"]}]}], ",", 
        RowBox[{"\[Sigma]", "=", 
         RowBox[{
          RowBox[{
           FractionBox["me", "Ee"], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["E\[Nu]", "2"], "-", 
             SuperscriptBox["f", "2"], "-", 
             SuperscriptBox["Ee", "2"], "+", 
             SuperscriptBox["me", "2"]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"l2", "-", 
             SuperscriptBox["mn", "2"], "-", 
             RowBox[{"2", " ", "E\[Gamma]", " ", "l0"}]}], ")"}]}], "+", 
          RowBox[{"4", " ", "E\[Gamma]", " ", "me", " ", 
           SuperscriptBox["f", "2"]}]}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Beta]", "2"], 
           SuperscriptBox["me", "2"], " ", 
           SuperscriptBox["E\[Nu]", "2"], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"l2", "-", 
                SuperscriptBox["mn", "2"]}], ")"}], "2"], "+", 
             RowBox[{"4", 
              SuperscriptBox["E\[Gamma]", "2"], "l2"}], "-", 
             RowBox[{"4", "l0", " ", "E\[Gamma]", 
              RowBox[{"(", 
               RowBox[{"l2", "-", 
                SuperscriptBox["mn", "2"]}], ")"}]}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{
                 SuperscriptBox["E\[Nu]", "2"], "+", 
                 RowBox[{
                  SuperscriptBox["\[Beta]", "2"], 
                  SuperscriptBox["Ee", "2"]}], "-", 
                 SuperscriptBox["f", "2"]}], 
                RowBox[{"2", "\[Beta]", " ", "E\[Nu]", " ", "Ee"}]], ")"}], 
              "2"]}], ")"}]}], "+", 
          FractionBox[
           SuperscriptBox["\[Sigma]", "2"], "4"]}]}]}], "}"}], ",", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"E\[Gamma]", " ", "E\[Nu]", " ", 
              SuperscriptBox["f", "4"], " ", 
              SuperscriptBox["\[Theta]", "2"], " ", 
              SuperscriptBox["me", "2"], " ", "\[Sigma]", " ", 
              RowBox[{"(", 
               RowBox[{"Ee", "+", "E\[Gamma]"}], ")"}]}], 
             SuperscriptBox["d", 
              RowBox[{"3", "/", "2"}]]]}], "+", 
           RowBox[{
            FractionBox[
             RowBox[{"E\[Nu]", " ", 
              SuperscriptBox["f", "2"], "\[Theta]"}], 
             SqrtBox["d"]], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"Ee", "+", "E\[Gamma]"}], ")"}], "2"], "+", 
              SuperscriptBox["Ee", "2"]}], ")"}]}], "-", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Ee", "+", "E\[Gamma]"}], ")"}], " ", "E\[Nu]"}], 
            RowBox[{"2", " ", "E\[Gamma]"}]]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["gV", "2"], "+", 
           SuperscriptBox["gA", "2"]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{
                SuperscriptBox["\[Theta]", "2"], 
                SuperscriptBox["f", "4"], 
                SuperscriptBox["me", "2"], " ", "\[Sigma]", " ", 
                "E\[Gamma]"}], 
               RowBox[{"2", 
                SuperscriptBox["d", 
                 RowBox[{"3", "/", "2"}]]}]], "-", 
              RowBox[{
               FractionBox[
                RowBox[{
                 SuperscriptBox["f", "2"], "me"}], 
                RowBox[{"2", 
                 SqrtBox["d"], " "}]], 
               FractionBox[
                RowBox[{"Ee", "+", "E\[Gamma]"}], "Ee"]}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"mp", " ", 
               RowBox[{"(", 
                RowBox[{"E\[Nu]", "-", "Ee", "-", "E\[Gamma]"}], ")"}]}], "-", 
              RowBox[{"mn", " ", "E0"}], "+", " ", 
              SuperscriptBox["me", "2"]}], ")"}]}], "+", 
           FractionBox[
            RowBox[{"E\[Nu]", "-", "Ee", "-", "E\[Gamma]"}], "4"], "+", 
           RowBox[{
            FractionBox[
             RowBox[{
              SuperscriptBox["f", "2"], "\[Theta]"}], 
             RowBox[{"4", 
              SqrtBox["d"], " "}]], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"E\[Nu]", "-", "Ee"}], ")"}], "2"], "-", 
                 SuperscriptBox["f", "2"]}], ")"}], "Ee"}], "+", 
              RowBox[{
               SuperscriptBox["me", "2"], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "E\[Gamma]"}], "-", "Ee"}], ")"}]}]}], ")"}]}], 
           "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"E\[Nu]", "-", "Ee"}], ")"}], "2"], "-", 
             SuperscriptBox["f", "2"], "-", 
             SuperscriptBox["me", "2"]}], 
            RowBox[{"8", "E\[Gamma]"}]]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["gV", "2"], "-", 
           SuperscriptBox["gA", "2"]}], ")"}]}]}], "]"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.956751311973534*^9, 3.9567515225830383`*^9}, {
